# /etc/ark/managed.toml — organisation policy (root-owned, 0644). Copy this file to
# /etc/ark/managed.toml and edit. Everything here is a default under the user and project
# layers, except keys listed in `[managed] locked`, which nobody below can change.
# Check the result with:  ark config managed
[managed]
locked = ["approvals.preset", "gate.egress_allow", "audit"]

[approvals]
preset = "standard"

[gate]
# egress_allow = ["api.anthropic.com", "*.corp.example"]
