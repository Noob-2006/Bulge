# seagent guest kernel: options shared by x86_64 and arm64.
#
# Applied on top of `make allnoconfig` (KCONFIG_ALLCONFIG), so anything not
# listed here or in the arch fragment is off. build-image.sh checks after
# configuring that every line below ended up in .config exactly as written: a
# symbol that silently lost a dependency fails the build instead of producing a
# kernel that does not boot.
#
# Everything is built in (CONFIG_MODULES is off): the guest has no /lib/modules
# and the agent never loads code into the kernel.

CONFIG_LOCALVERSION="-seagent"
CONFIG_DEFAULT_HOSTNAME="seagent-vm"
# CONFIG_MODULES is not set

# ── core ──────────────────────────────────────────────────────────────────
CONFIG_SMP=y
CONFIG_NR_CPUS=32
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_SECCOMP=y
CONFIG_PRINTK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ── file systems: the root is the initramfs, everything else is tmpfs ──────
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_FILE_LOCKING=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set

# ── network stack: loopback + unix sockets for tools, AF_VSOCK for the channel
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# ── virtio over PCI (QEMU, vfkit, crosvm, VirtualBox) and MMIO (Firecracker) ─
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# ── consoles: 16550 (ttyS0 console, ttyS1 = the `uart` channel) ──────────────
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# ── firmware + wall clock ─────────────────────────────────────────────────
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
