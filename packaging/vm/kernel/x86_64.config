# seagent guest kernel, x86_64 additions (on top of common.config).
#
# One kernel for every x86_64 host: the ELF `vmlinux` boots under Firecracker
# and QEMU (-kernel, via the PVH entry point); the same build as `bzImage` is
# an EFI application (BOOTX64.EFI) for the VirtualBox / Hyper-V disk.

CONFIG_64BIT=y
CONFIG_X86_MPPARSE=y
CONFIG_X86_X2APIC=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PVH=y
# Hyper-V Gen 2 has no PIT/HPET: its synthetic timer and clock come from here.
CONFIG_HYPERV=y
CONFIG_PNP=y
CONFIG_PNPACPI=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_EFI_STUB=y
CONFIG_RELOCATABLE=y
CONFIG_RTC_DRV_CMOS=y
# QEMU fw_cfg in sysfs: Windows QEMU hands the guest its per-boot channel key as
# opt/seagent/key (the loopback TCP channel is reachable by other local processes).
CONFIG_FW_CFG_SYSFS=y
# SMBIOS in sysfs (/sys/class/dmi/id/product_serial, root-only): VirtualBox / Hyper-V on
# Windows hand the guest its channel key as the system serial (their COM2 is a named pipe).
CONFIG_DMIID=y
