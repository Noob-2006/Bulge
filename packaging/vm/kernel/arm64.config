# seagent guest kernel, arm64 additions (on top of common.config).
#
# The raw `Image` boots directly under vfkit (Virtualization.framework), QEMU
# -M virt (HVF/KVM), crosvm (Android AVF) and Firecracker; with CONFIG_EFI the
# same Image is also a PE/COFF EFI application (BOOTAA64.EFI) for the disk.

CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# crosvm and Firecracker describe a 16550 in the device tree.
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_RTC_DRV_PL031=y
CONFIG_RTC_DRV_EFI=y
