[Unit]
Description=ark agent daemon (system)
Documentation=https://github.com/ark-agent/ark
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=ark
Group=ark
StateDirectory=ark ark/workspace
StateDirectoryMode=0750
Environment=ARK_HOME=/var/lib/ark
ExecStart=/usr/bin/ark daemon run -w /var/lib/ark/workspace
WorkingDirectory=/var/lib/ark/workspace
Restart=on-failure
RestartSec=5s
# SIGTERM to arkd first (it interrupts runs and saves state), then the rest of the group.
KillMode=mixed
TimeoutStopSec=30s
# ent-024: a delegated cgroup subtree, so `[exec.cgroups]` can give every command its own
# cgroup (escaped double-forks are reaped, memory/pids caps apply) on cgroup v1 and v2.
Delegate=yes
# ark refuses sudo by policy; make that impossible rather than merely discouraged.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictRealtime=yes
UMask=0077
# A system manager can apply the full sandbox (user units cannot without user namespaces).
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
# Not set on purpose: MemoryDenyWriteExecute (breaks Node/V8 bridges), ProtectHome and
# RestrictNamespaces (the sandboxes ark may run need them).

[Install]
WantedBy=multi-user.target
