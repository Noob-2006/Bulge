# Guest root filesystem for bulge. Built rootless with podman, exported as a
# plain directory that libkrun serves to the guest (the guest remounts it ro).
# firefox: the `browser` tool drives it headless over WebDriver BiDi (sandboxd);
# font-noto(-cjk) so pages in any script, Chinese included, render legibly.
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache \
      bash coreutils findutils grep sed gawk diffutils patch file less \
      tar gzip xz unzip zstd \
      ca-certificates curl wget openssl \
      git ripgrep jq \
      python3 py3-pip nodejs npm \
      build-base \
      firefox font-noto font-noto-cjk
# Mount points the guest uses at boot must exist in the image: the rootfs is
# served read-only (the VMM's Landlock grants it read access only), so the guest
# cannot create them itself.
RUN mkdir -p /workspace /usr/local/share/bulge /run/bulge
COPY udhcpc.script /usr/local/share/bulge/udhcpc.script
COPY sandboxd /usr/local/bin/sandboxd
