# Managed by Ansible - do not edit by hand. Read by ark from /etc/ark (see: ark config managed).
{% macro emit(tbl, prefix) -%}
{% set scalars = tbl | dict2items | rejectattr('value', 'mapping') | list %}
{% set tables = tbl | dict2items | selectattr('value', 'mapping') | list %}
{% if scalars and prefix %}

[{{ prefix }}]
{% endif %}
{% for kv in scalars %}
{{ kv.key }} = {{ kv.value | to_json }}
{% endfor %}
{% for kv in tables %}
{{ emit(kv.value, (prefix ~ '.' if prefix else '') ~ kv.key) }}
{% endfor %}
{%- endmacro -%}
{{ emit(ark_managed_policy, '') }}
