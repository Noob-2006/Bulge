/target/
# Copied from ui/ by src-tauri/build.rs
/src/vendor/
# The seagent sidecar, built per target triple by scripts/prepare-sidecar.sh
/src-tauri/binaries/*
!/src-tauri/binaries/README.md
# Generated by tauri-build / `cargo tauri android|ios init`
/src-tauri/gen/
/src-tauri/tauri.ci.conf.json
/src-tauri/tauri.rpm.conf.json
/src-tauri/permissions/autogenerated/
/plugins/seagent-mobile/permissions/
/dist/
__pycache__/
# Downloaded by scripts/fetch-cjk-font.sh (AppImage CJK font, pinned + sha256)
/src-tauri/fonts/*.ttf
# Built by scripts/build-wasi-tools.sh (iOS WASI tools, pinned + sha256 in tools.json)
/src-tauri/wasi-tools/
# Downloaded by scripts/fetch-vdd.sh (Windows virtual display driver, pinned + sha256)
/src-tauri/windows/vdd/driver/
# Staged by packaging/vm/bundle.sh (the built-in VM: guest image + hypervisor, pinned + sha256)
/src-tauri/vm/
