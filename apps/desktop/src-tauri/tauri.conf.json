{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SE Agent",
  "mainBinaryName": "seagent-desktop",
  "version": "0.2.0-alpha",
  "identifier": "dev.seagent.agent",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main", "console"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "appimage", "deb", "rpm"],
    "publisher": "SE Agent contributors",
    "copyright": "Copyright 2026 The SE Agent Authors, Apache License 2.0",
    "category": "DeveloperTool",
    "shortDescription": "Self-hosted AI agent",
    "longDescription": "SE Agent is a self-hosted AI agent. This app installs and runs the agent's background service for the current user and opens its web console and setup wizard.",
    "homepage": "https://github.com/Noob-2006/SE-Agent",
    "license": "Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/seagent"],
    "resources": {
      "../../../share/": "share/"
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "TradChinese", "SimpChinese"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "SE Agent"
      },
      "wix": {
        "language": ["en-US", "zh-TW", "zh-CN"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "macos/entitlements.plist",
      "dmg": {
        "windowSize": { "width": 640, "height": 400 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 460, "y": 200 }
      }
    },
    "linux": {
      "deb": {
        "recommends": ["fonts-noto-cjk", "qemu-system-x86", "qemu-utils"],
        "section": "utils"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3"],
        "recommends": ["google-noto-sans-cjk-ttc-fonts", "qemu-system-x86-core", "qemu-img"]
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/seagent-desktop/fonts/NotoSansTC-VF.ttf": "fonts/NotoSansTC-VF.ttf",
          "/usr/share/seagent-desktop/fonts/OFL.txt": "fonts/OFL.txt",
          "/usr/share/seagent-desktop/fonts/fonts.conf": "fonts/fonts.conf"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Noob-2006/SE-Agent/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
