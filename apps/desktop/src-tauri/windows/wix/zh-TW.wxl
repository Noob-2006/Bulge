<?xml version="1.0" encoding="utf-8"?>
<!-- SE Agent 自己的 MSI 字串；沒列在這裡的字串由 Tauri 補上預設值。 -->
<WixLocalization Culture="zh-tw" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="SeagentNsisPresent">這台電腦已經用 SE Agent 安裝程式（setup.exe）裝過 SE Agent。請直接用 setup.exe 更新；若要改用 MSI，請先到「設定 → 應用程式」解除安裝 SE Agent，再執行這個 MSI。</String>
</WixLocalization>
